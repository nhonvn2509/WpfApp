<Application x:Class="WpfApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfApp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xceed.Wpf.Toolkit;component/themes/generic/brushes.xaml" />
                <ResourceDictionary Source="Views/Resources/Icons.xaml" />
                <ResourceDictionary Source="Views/Themes/ThemeMidnight.xaml" />
                <ResourceDictionary Source="Views/Resources/Metrics.xaml" />
                <ResourceDictionary Source="Views/Resources/TableStyles.xaml" />
                <ResourceDictionary Source="Views/Themes/CommonControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
