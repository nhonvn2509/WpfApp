<Window x:Class="WpfApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        xmlns:viewControls="clr-namespace:WpfApp.Views.Controls"
        xmlns:tables="clr-namespace:WpfApp.Views.Tables"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Loaded="MainWindow_Loaded"
        Title="DeltaBat"
        Icon="/Assets/VSAT.ico"
        Width="1500"
        Height="920"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        mc:Ignorable="d">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <DockPanel>
        <viewControls:WindowCaptionBar DockPanel.Dock="Top" />

        <viewControls:CommandBar DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="10,0,12,0"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource ThirdlyTextBrush}"
                           Text="{Binding DatabaseTotals}"
                           ToolTip="Số phiên và tệp khớp bộ lọc hiện tại / tổng số trong CSDL" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="12,0,10,0"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource ThirdlyTextBrush}"
                           Text="{Binding StatusBarMessage}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusBarMessage}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource ThirdlyTextBrush}"
                           Text="{Binding ActiveSelectedSummary}" />

                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource ThirdlyTextBrush}"
                           Text="{Binding NewPrioritySummary}" />

                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           Margin="12,0,10,0"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource ThirdlyTextBrush}"
                           Text="{Binding SessionTotalSummary}" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SideColumn" Width="360" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <viewControls:NavPane x:Name="Nav"
                                 Grid.Column="0"
                                 Visibility="{Binding IsNavPaneOpen, Converter={StaticResource Boolean2VisibilityConverter}}" />

            <GridSplitter x:Name="NavSplitter"
                          Grid.Column="1"
                          Style="{StaticResource ShellGridSplitter}"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding IsNavPaneOpen, Converter={StaticResource Boolean2VisibilityConverter}}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TabPanel Grid.Row="0"
                                          IsItemsHost="True"
                                          Margin="0,0,0,6"
                                          KeyboardNavigation.TabIndex="1" />
                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="SelectedContent"
                                                  KeyboardNavigation.TabNavigation="Local" />
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabItem x:Name="SessionsTab"
                             Header="Phiên"
                             Style="{StaticResource WorkspaceTabItem}"
                             IsSelected="{Binding Sessions.IsActive, Mode=TwoWay}">
                        <tables:SessionsTableView />
                    </TabItem>
                    <TabItem x:Name="ChainsTab"
                             Header="Nguồn"
                             Style="{StaticResource WorkspaceTabItem}"
                             IsSelected="{Binding Chains.IsActive, Mode=TwoWay}">
                        <tables:ChainsTableView />
                    </TabItem>
                </TabControl>

                <viewControls:FilePreviewPane x:Name="PreviewPane"
                                              Grid.Row="2"
                                              Height="260"
                                              Margin="8,6"
                                              DataContext="{Binding SessionFiles}" />

                <Border Grid.Row="3" Style="{StaticResource TableStatusBarPanel}">
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource TableStatusBarMutedText}"
                               Text="{Binding PageSummary}" />
                </Border>
            </Grid>
            <GridSplitter x:Name="SideSplitter"
                          Grid.Column="3"
                          Style="{StaticResource ShellGridSplitter}"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding IsSidePaneOpen, Converter={StaticResource Boolean2VisibilityConverter}}" />

            <Grid Grid.Column="4"
                  Visibility="{Binding IsSidePaneOpen, Converter={StaticResource Boolean2VisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PaneHeaderPanel}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="Info"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0,0,8,0"
                                                  Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock FontSize="{StaticResource FontSizeSubtitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{Binding SideDetailTitle}" />
                    </StackPanel>
                </Border>

                <viewControls:SessionFilesPane Grid.Row="1"
                                               DataContext="{Binding SessionFiles}"
                                               Visibility="{Binding DataContext.IsSessionsTabActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Boolean2VisibilityConverter}}" />

                <viewControls:ChainDetailPane Grid.Row="1"
                                              DataContext="{Binding Chains}"
                                              Visibility="{Binding DataContext.IsChainsTabActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Boolean2VisibilityConverter}}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
