<UserControl x:Class="WpfApp.Views.Tables.ContactsTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewControls="clr-namespace:WpfApp.Views.Controls">
    <Grid DataContext="{Binding Contacts}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource TableFilterCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TableLabel}" Text="Tìm kiếm" />
                    <hc:TextBox Style="{StaticResource TableSearchBox}"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Tên, giá trị hoặc ghi chú của contact"
                                 AutomationProperties.AutomationId="ContactsSearchBox">
                        <hc:TextBox.InputBindings>
                            <KeyBinding Command="{Binding ApplyFilterCommand}" Key="Enter" />
                        </hc:TextBox.InputBindings>
                    </hc:TextBox>
                    <Button Content="Tìm"
                            Command="{Binding ApplyFilterCommand}"
                            Style="{StaticResource TablePrimaryButton}"
                            ContentTemplate="{StaticResource IconTextContentTemplate}"
                            Tag="Search" />
                    <Button Content="Xóa lọc"
                            Command="{Binding ClearFilterCommand}"
                            Style="{StaticResource TableToolButton}"
                            ContentTemplate="{StaticResource IconTextContentTemplate}"
                            Tag="X" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource TableFilterStatusPanel}">
                    <TextBlock Foreground="{DynamicResource PrimaryBrush}"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ErrorMessage}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Items}"
                      RowStyle="{StaticResource TableRowStyle}"
                      ColumnHeaderStyle="{StaticResource TableColumnHeaderStyle}"
                      viewControls:SelectionCheckBoxColumn.Visible="{Binding CanSelect}">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource TableGrid}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40"
                                            CellTemplate="{StaticResource RowSelectionCheckBox}"
                                            HeaderTemplate="{StaticResource RowSelectionHeaderCheckBox}"
                                            HeaderStyle="{StaticResource SelectionCheckBoxColumnHeaderStyle}" />
                    <DataGridTextColumn Width="80" Binding="{Binding IdC}" Header="ID" />
                    <DataGridTextColumn Width="90" Binding="{Binding IdS}" Header="Session" />
                    <DataGridTextColumn Width="150" Binding="{Binding Name}" Header="Tên" />
                    <DataGridTextColumn Width="80" Binding="{Binding Direction}" Header="Hướng" />
                    <DataGridTextColumn Width="260" Binding="{Binding Value}" Header="Giá trị" />
                    <DataGridTextColumn Width="120" Binding="{Binding Type}" Header="Loại" />
                    <DataGridTextColumn Width="70" Binding="{Binding Priority}" Header="Ưu tiên" />
                    <DataGridTextColumn Width="150" Binding="{Binding Start, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Header="Thời gian" />
                    <DataGridTextColumn Width="*" Binding="{Binding Remark}" Header="Ghi chú" />
                </DataGrid.Columns>
            </DataGrid>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20,16"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
                <StackPanel MinWidth="220">
                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontWeight="SemiBold"
                               Text="Đang tải danh sách liên hệ..." />
                    <ProgressBar Height="6"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
        <viewControls:TablePagination Grid.Row="2" />
    </Grid>
</UserControl>
