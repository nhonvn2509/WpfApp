<UserControl x:Class="WpfApp.Views.Tables.SessionsTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewControls="clr-namespace:WpfApp.Views.Controls"
             xmlns:xceed="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit">
    <Grid DataContext="{Binding Sessions}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource TableFilterCard}">
            <ScrollViewer Style="{StaticResource HorizontalFilterScrollViewer}">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TableLabel}" Text="Tìm kiếm" />
                    <hc:TextBox Style="{StaticResource TableSearchBox}"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Tên session hoặc ghi chú"
                                 AutomationProperties.AutomationId="SessionsSearchBox">
                        <hc:TextBox.InputBindings>
                            <KeyBinding Command="{Binding ApplyFilterCommand}" Key="Enter" />
                        </hc:TextBox.InputBindings>
                    </hc:TextBox>
                    <StackPanel Orientation="Horizontal" Margin="8,6,8,6">
                        <TextBlock Style="{StaticResource TableLabel}" Text="Từ ngày" />
                        <xceed:DateTimePicker Value="{Binding FromDate, Mode=TwoWay}"
                                              Style="{StaticResource TableDateTimePicker}"
                                              ToolTip="Chỉ lấy phiên bắt đầu từ thời điểm này" />
                        <TextBlock Style="{StaticResource TableLabel}" Text="Đến ngày" />
                        <xceed:DateTimePicker Value="{Binding ToDate, Mode=TwoWay}"
                                              Style="{StaticResource TableDateTimePicker}"
                                              ToolTip="Chỉ lấy phiên bắt đầu đến thời điểm này" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource TableLabel}" Text="Trạng thái" />
                    <hc:ComboBox Style="{StaticResource TableFilterComboBox}"
                                 ItemsSource="{Binding StatusOptions}"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Id"
                                 SelectedValue="{Binding StatusId, Mode=TwoWay}"
                                 ToolTip="Lọc session theo trạng thái" />
                    <Button Content="Tìm"
                            Command="{Binding ApplyFilterCommand}"
                            Style="{StaticResource TablePrimaryButton}"
                            ContentTemplate="{StaticResource IconTextContentTemplate}"
                            Tag="Search"
                            AutomationProperties.AutomationId="SessionsFindButton" />
                    <Button Content="Xóa lọc"
                            Command="{Binding ClearFilterCommand}"
                            Style="{StaticResource TableToolButton}"
                            ContentTemplate="{StaticResource IconTextContentTemplate}"
                            Tag="X" />
                    <Button Content="Làm mới"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource TableToolButton}"
                            ContentTemplate="{StaticResource IconTextContentTemplate}"
                            Tag="RefreshCw"
                            AutomationProperties.AutomationId="SessionsRefreshButton"
                            ToolTip="Tải lại danh sách phiên hiện tại" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="1">
            <DataGrid x:Name="SessionsGrid"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      RowStyle="{StaticResource TableRowStyle}"
                      ColumnHeaderStyle="{StaticResource TableColumnHeaderStyle}"
                      PreviewMouseRightButtonDown="SessionsGrid_PreviewMouseRightButtonDown"
                      SelectionChanged="SessionsGrid_SelectionChanged"
                      ContextMenuOpening="SessionsGrid_ContextMenuOpening"
                      viewControls:SelectionCheckBoxColumn.Visible="{Binding CanSelect}">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource TableGrid}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                </DataGrid.Tag>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Mở phiên"
                                  Command="{Binding OpenContextSessionCommand}"
                                  Visibility="{Binding Sessions.HasSingleContextSelection, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        <Separator Visibility="{Binding Sessions.HasSingleContextSelection, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        <MenuItem Header="Lưu phiên (các phiên đã tick)"
                                  Command="{Binding OpenSaveSessionsForCheckedSessionsCommand}"
                                  ToolTip="Mở hộp thoại lưu với phạm vi các phiên đã tick ở bảng Phiên" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40"
                                            CellTemplate="{StaticResource RowSelectionCheckBox}"
                                            HeaderTemplate="{StaticResource RowSelectionHeaderCheckBox}"
                                            HeaderStyle="{StaticResource SelectionCheckBoxColumnHeaderStyle}" />
                    <DataGridTextColumn Width="80" Binding="{Binding IdS}" Header="Mã" />
                    <DataGridTemplateColumn Width="150" CellTemplate="{StaticResource SessionNameCellTemplate}" Header="Tên" />
                    <DataGridTextColumn Width="150" Binding="{Binding Start, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Header="Bắt đầu" />
                    <DataGridTextColumn Width="150" Binding="{Binding Final, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Header="Kết thúc" />
                    <DataGridTextColumn Width="150" Binding="{Binding IpFrom}" Header="IP From" />
                    <DataGridTextColumn Width="150" Binding="{Binding IpTo}" Header="IP To" />
                    <DataGridTextColumn Width="130" Binding="{Binding PhoneFrom}" Header="Phone From" />
                    <DataGridTextColumn Width="130" Binding="{Binding PhoneTo}" Header="Phone To" />
                    <DataGridTextColumn Width="100" Binding="{Binding Duration}" Header="Thời lượng" />
                    <DataGridTemplateColumn Width="140" CellTemplate="{StaticResource StatusCellTemplate}" Header="Trạng thái" />
                    <DataGridTemplateColumn Width="120" CellTemplate="{StaticResource DataTypeCellTemplate}" Header="Loại" />
                    <DataGridTemplateColumn Width="140" CellTemplate="{StaticResource SessionChainCellTemplate}" Header="Nguồn" />
                    <DataGridTextColumn Width="85" Binding="{Binding Files}" Header="Số tệp" />
                    <DataGridTemplateColumn Width="80" CellTemplate="{StaticResource SessionPriorityCellTemplate}" Header="Ưu tiên" />
                    <DataGridTemplateColumn Width="85" CellTemplate="{StaticResource SessionQualityCellTemplate}" Header="Chất lượng" />
                    <DataGridTextColumn Width="240" Binding="{Binding Memo}" Header="Ghi chú" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource TableEmptyStateText}"
                       Text="{Binding EmptyStateMessage}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20,16"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
                <StackPanel MinWidth="220">
                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontWeight="SemiBold"
                               Text="Đang tải danh sách phiên..." />
                    <ProgressBar Height="6"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
        <viewControls:TablePagination Grid.Row="2" />
    </Grid>
</UserControl>
