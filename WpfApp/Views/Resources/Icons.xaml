<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
                    xmlns:presentation="clr-namespace:WpfApp.Presentation">

    <presentation:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrush" />

    <Style x:Key="LucideIcon" TargetType="{x:Type iconPacks:PackIconLucide}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="IconTextContentTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconLucide Kind="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Control}}}"
                                      Width="18"
                                      Height="18"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
            <TextBlock Margin="0"
                       VerticalAlignment="Center"
                       Text="{Binding}"
                       TextTrimming="CharacterEllipsis"
                       SnapsToDevicePixels="True" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SessionNameCellTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconLucide Kind="{Binding SessionIconKind}"
                                      Style="{StaticResource LucideIcon}"
                                      Foreground="{DynamicResource InfoBrush}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Name}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="StatusCellTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconLucide Kind="{Binding StatusIconKind}"
                                      Style="{StaticResource LucideIcon}"
                                      Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceKeyToBrush}}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding StatusName}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DataTypeCellTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconLucide Kind="{Binding TypeIconKind}"
                                      Style="{StaticResource LucideIcon}"
                                      Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding TypeName}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SessionChainCellTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconLucide Kind="Link2"
                                      Style="{StaticResource LucideIcon}"
                                      Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding ChainName}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ChainProfileCellTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconLucide Kind="Link2"
                                      Style="{StaticResource LucideIcon}"
                                      Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Profile}" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="QualityStar" TargetType="{x:Type iconPacks:PackIconLucide}">
        <Setter Property="Kind" Value="Star" />
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource BorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Filled}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="SessionPriorityCellTemplate">
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="0"
                Padding="8,3"
                CornerRadius="10"
                ToolTip="{Binding PriorityBadge.ToolTip}"
                Background="{Binding PriorityBadge.BackgroundBrushKey, Converter={StaticResource ResourceKeyToBrush}}"
                Visibility="{Binding PriorityBadge.HasValue, Converter={StaticResource Boolean2VisibilityConverter}}">
            <TextBlock Text="{Binding PriorityBadge.Text}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{Binding PriorityBadge.ForegroundBrushKey, Converter={StaticResource ResourceKeyToBrush}}" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="SessionQualityCellTemplate">
        <ItemsControl ItemsSource="{Binding QualityStars}"
                      VerticalAlignment="Center"
                      ToolTip="{Binding QualityStarsText}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <iconPacks:PackIconLucide Style="{StaticResource QualityStar}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="ChainSourceCellTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconLucide Kind="Radio"
                                      Style="{StaticResource LucideIcon}"
                                      Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Source}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ChainSatelliteCellTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconLucide Kind="Satellite"
                                      Style="{StaticResource LucideIcon}"
                                      Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Satellite}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
