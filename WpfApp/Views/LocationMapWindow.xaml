<Window x:Class="WpfApp.Views.LocationMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp.Views.Controls"
        Title="Bản đồ vị trí — DeltaBat"
        Icon="/Assets/VSAT.ico"
        Width="1200"
        Height="820"
        MinWidth="720"
        MinHeight="480"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:LocationMapPane />
        <TextBlock Grid.Row="1"
                   Margin="2,8,2,0"
                   HorizontalAlignment="Right"
                   FontSize="10"
                   Foreground="{DynamicResource ThirdlyTextBrush}"
                   Text="© OpenStreetMap contributors · Geofabrik · BBBike · ODbL" />
    </Grid>
</Window>
