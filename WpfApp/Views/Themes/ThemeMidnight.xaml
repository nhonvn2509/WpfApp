    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlDisabledBackgroundKey}" Color="#151A22" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlNormalBorderKey}" Color="#2E3846" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlMouseOverBorderKey}" Color="#4C9AFF" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlFocusedBorderKey}" Color="#4C9AFF" />

    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.GlyphNormalForegroundKey}" Color="#EDF1F7" />
