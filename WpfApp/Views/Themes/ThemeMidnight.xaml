    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonNormalBackgroundKey}" Color="#232B36" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonMouseOverBackgroundKey}" Color="#2C3644" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonPressedBackgroundKey}" Color="#1B212B" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonNormalInnerBorderKey}" Color="#2C3644" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonNormalOuterBorderKey}" Color="#38424F" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonMouseOverOuterBorderKey}" Color="#4C9AFF" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonFocusedOuterBorderKey}" Color="#4C9AFF" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonDisabledOuterBorderKey}" Color="#2E3846" />

    <CornerRadius x:Key="{x:Static xceedThemes:ResourceKeys.SpinButtonCornerRadiusKey}">4</CornerRadius>
</ResourceDictionary>
