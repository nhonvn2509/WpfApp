    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#333794FF" />
    <SolidColorBrush x:Key="SplitterDragBrush" Color="#3794FF" />
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#1F89D185" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#1FCCA700" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#1FF14C4C" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#1F4E94CE" />






    <SolidColorBrush x:Key="DockPaneHeaderBrush" Color="#181818" />
