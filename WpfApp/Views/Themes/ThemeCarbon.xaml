    <SolidColorBrush x:Key="PriorityHighBrush" Color="#26DCDCAA" />
    <SolidColorBrush x:Key="PriorityTopBrush" Color="#26F14C4C" />



    <SolidColorBrush x:Key="ControlBrushKey" Color="#1F1F1F" />
    <SolidColorBrush x:Key="ControlDarkBrushKey" Color="#181818" />
