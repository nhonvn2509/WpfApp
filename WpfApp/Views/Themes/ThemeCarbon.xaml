<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xceedThemes="clr-namespace:Xceed.Wpf.Toolkit.Themes;assembly=Xceed.Wpf.Toolkit">

    <SolidColorBrush x:Key="RegionBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="DarkRegionBrush" Color="#181818" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#252526" />
    <SolidColorBrush x:Key="TertiaryRegionBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ElevatedRegionBrush" Color="#3C3C3C" />

    <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#4A4A4A" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#9D9D9D" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6E6E6E" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="#3794FF" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="#7AB7FF" />
    <SolidColorBrush x:Key="InfoBrush" Color="#4E94CE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#89D185" />
    <SolidColorBrush x:Key="WarningBrush" Color="#CCA700" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F14C4C" />

    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="OverlaySelectedBrush" Color="#1F3794FF" />
    <SolidColorBrush x:Key="OverlaySelectedHoverBrush" Color="#2E3794FF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#333794FF" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#3794FF" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#174D78" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectedIconBrush" Color="#8BC7FF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#174D78" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#174D78" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="ColumnHeaderHoverBrush" Color="#2A2A2A" />
