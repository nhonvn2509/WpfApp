    <SolidColorBrush x:Key="HighlightTextBrushKey" Color="#CCCCCC" />
    <SolidColorBrush x:Key="GrayTextBrushKey" Color="#9D9D9D" />

    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlNormalBackgroundKey}" Color="#252526" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlDisabledBackgroundKey}" Color="#1F1F1F" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlNormalBorderKey}" Color="#333333" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlMouseOverBorderKey}" Color="#1177BB" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlFocusedBorderKey}" Color="#0078D4" />

    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.GlyphNormalForegroundKey}" Color="#CCCCCC" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.GlyphDisabledForegroundKey}" Color="#6E6E6E" />

    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonNormalBackgroundKey}" Color="#3C3C3C" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonMouseOverBackgroundKey}" Color="#454545" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonPressedBackgroundKey}" Color="#2D2D2D" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonNormalInnerBorderKey}" Color="#454545" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonNormalOuterBorderKey}" Color="#555555" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonMouseOverOuterBorderKey}" Color="#1177BB" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonFocusedOuterBorderKey}" Color="#0078D4" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonDisabledOuterBorderKey}" Color="#333333" />

    <CornerRadius x:Key="{x:Static xceedThemes:ResourceKeys.SpinButtonCornerRadiusKey}">4</CornerRadius>
