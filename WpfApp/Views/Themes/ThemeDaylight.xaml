    <SolidColorBrush x:Key="PriorityLowBrush" Color="#26B2BECD" />
    <SolidColorBrush x:Key="PriorityNormalBrush" Color="#264C9AFF" />
    <SolidColorBrush x:Key="PriorityGoodBrush" Color="#263FD07F" />
    <SolidColorBrush x:Key="PriorityHighBrush" Color="#26FF9F1A" />
    <SolidColorBrush x:Key="PriorityTopBrush" Color="#26F0616D" />



    <SolidColorBrush x:Key="ControlBrushKey" Color="#F5F7FA" />
    <SolidColorBrush x:Key="ControlDarkBrushKey" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GradientInactiveCaptionBrushKey" Color="#E9EDF3" />
