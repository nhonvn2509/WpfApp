    <SolidColorBrush x:Key="HighlightTextBrushKey" Color="#1B2430" />
    <SolidColorBrush x:Key="GrayTextBrushKey" Color="#4B5768" />

    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlNormalBackgroundKey}" Color="#E9EDF3" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlDisabledBackgroundKey}" Color="#F0F3F7" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlNormalBorderKey}" Color="#C7D0DC" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlMouseOverBorderKey}" Color="#1F6FEB" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ControlFocusedBorderKey}" Color="#1F6FEB" />

    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.GlyphNormalForegroundKey}" Color="#1B2430" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.GlyphDisabledForegroundKey}" Color="#8A94A3" />

    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonNormalBackgroundKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonMouseOverBackgroundKey}" Color="#E9EDF3" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonPressedBackgroundKey}" Color="#DCE3EC" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonNormalInnerBorderKey}" Color="#E9EDF3" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonNormalOuterBorderKey}" Color="#C7D0DC" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonMouseOverOuterBorderKey}" Color="#1F6FEB" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonFocusedOuterBorderKey}" Color="#1F6FEB" />
    <SolidColorBrush x:Key="{x:Static xceedThemes:ResourceKeys.ButtonDisabledOuterBorderKey}" Color="#C7D0DC" />

    <CornerRadius x:Key="{x:Static xceedThemes:ResourceKeys.SpinButtonCornerRadiusKey}">4</CornerRadius>
</ResourceDictionary>
