    <SolidColorBrush x:Key="ColumnHeaderHoverBrush" Color="#DCE3EC" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#BAC4D2" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#98A5B6" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#331F6FEB" />
    <SolidColorBrush x:Key="SplitterDragBrush" Color="#1F6FEB" />
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#1F1F9D55" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#1FB4720A" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#1FC92A3D" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#1F1F6FEB" />






    <SolidColorBrush x:Key="DockPaneHeaderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="DockTabInactiveForegroundBrush" Color="#6C7787" />
