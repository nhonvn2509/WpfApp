<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xceedThemes="clr-namespace:Xceed.Wpf.Toolkit.Themes;assembly=Xceed.Wpf.Toolkit">

    <SolidColorBrush x:Key="RegionBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="DarkRegionBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#E9EDF3" />
    <SolidColorBrush x:Key="TertiaryRegionBrush" Color="#DCE3EC" />
    <SolidColorBrush x:Key="ElevatedRegionBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="BorderBrush" Color="#C7D0DC" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#DCE3EC" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#A8B4C4" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#4B5768" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#8A94A3" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="#1F6FEB" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#14509F" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="#6BA5F5" />
    <SolidColorBrush x:Key="InfoBrush" Color="#1F6FEB" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1F9D55" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B4720A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C92A3D" />

    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="OverlaySelectedBrush" Color="#1F1F6FEB" />
    <SolidColorBrush x:Key="OverlaySelectedHoverBrush" Color="#2E1F6FEB" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#331F6FEB" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#1F6FEB" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#D7E7FF" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="SelectedIconBrush" Color="#1457A5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D7E7FF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B2430" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D7E7FF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B2430" />
