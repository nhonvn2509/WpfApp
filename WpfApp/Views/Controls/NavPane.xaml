<UserControl x:Class="WpfApp.Views.Controls.NavPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <TabControl x:Name="NavTabs"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                SelectedIndex="{Binding SelectedNavTabIndex, Mode=TwoWay}">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TabPanel Grid.Row="0"
                              IsItemsHost="True"
                              Margin="2,0,2,4"
                              KeyboardNavigation.TabIndex="1" />
                    <ContentPresenter Grid.Row="1"
                                      ContentSource="SelectedContent"
                                      KeyboardNavigation.TabNavigation="Local" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem x:Name="TreeTab"
                 Header="Cây tệp"
                 Style="{StaticResource NavTabItem}">
            <Grid x:Name="TreeContent">
                <TreeView Margin="6,0,6,6"
                      ItemsSource="{Binding SessionFiles.SessionTree}"
                      Style="{StaticResource SessionFileTree}"
                      Loaded="SessionFileTree_Loaded"
                      PreviewMouseLeftButtonDown="SessionFileTree_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="SessionFileTree_PreviewMouseRightButtonDown"
                      ContextMenuOpening="SessionFileTree_ContextMenuOpening"
                      PreviewMouseLeftButtonUp="SessionFileTree_PreviewMouseLeftButtonUp"
                      SelectedItemChanged="SessionTree_SelectedItemChanged">
                    <TreeView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Preview"
                                      Command="{Binding SessionFiles.PreviewContextSelectionCommand}"
                                      Visibility="{Binding SessionFiles.HasSingleContextSelection, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            <MenuItem Header="Lưu phiên (các phiên đã tick)"
                                      Command="{Binding OpenSaveSessionsForCheckedSessionsCommand}"
                                      Visibility="{Binding SessionFiles.HasMultipleContextSelections, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource SessionFileTreeItem}">
                        <EventSetter Event="Expanded" Handler="SessionFileTree_Expanded" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Border x:Name="TreeNodeBorder"
                                Margin="0,2,0,2"
                                Padding="6,4,6,4"
                                CornerRadius="6"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconLucide x:Name="FileIcon"
                                                          Grid.Column="0"
                                                          Width="17"
                                                          Height="17"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Kind="{Binding IconKind}"
                                                          Foreground="{Binding IconBrushKey, Converter={StaticResource ResourceKeyToBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="DisplayNameText"
                                               Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DetailsText"
                                               Text="{Binding Details}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ThirdlyTextBrush}" />
                                    <ProgressBar x:Name="ChildrenLoadingProgress"
                                                 Height="3"
                                                 Margin="0,4,0,0"
                                                 IsIndeterminate="True"
                                                 Foreground="{DynamicResource PrimaryBrush}"
                                                 Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsContextSelected}" Value="True">
                                <Setter TargetName="TreeNodeBorder" Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                                <Setter TargetName="FileIcon" Property="Foreground" Value="{DynamicResource SelectedIconBrush}" />
                                <Setter TargetName="DisplayNameText" Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                                <Setter TargetName="DetailsText" Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoadingChildren}" Value="True">
                                <Setter TargetName="DetailsText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ChildrenLoadingProgress" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                         Value="True">
                                <Setter TargetName="FileIcon" Property="Foreground" Value="{DynamicResource SelectedIconBrush}" />
                                <Setter TargetName="DisplayNameText" Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                                <Setter TargetName="DetailsText" Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </TabItem>

        <TabItem x:Name="ExtensionsTab"
                 Header="Đuôi file"
                 Style="{StaticResource NavTabItem}">
            <Grid x:Name="ExtensionsContent"
                  DataContext="{Binding FileExtensions}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <DataGrid Margin="6,0"
                              ItemsSource="{Binding ExtensionRows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              RowStyle="{StaticResource TableRowStyle}"
                              ColumnHeaderStyle="{StaticResource TableColumnHeaderStyle}"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              SelectionMode="Single">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource TableGridCompact}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Tick phần mở rộng này" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.Header>
                                    <CheckBox FontSize="11"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding DataContext.AreAllExtensionsSelected, RelativeSource={RelativeSource AncestorType={x:Type Grid}}, Mode=TwoWay}"
                                              ToolTip="Chọn / bỏ chọn tất cả phần mở rộng" />
                                </DataGridTemplateColumn.Header>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Đuôi file" />
                            <DataGridTextColumn Width="70" Binding="{Binding Count, StringFormat={}{0:N0}}" Header="Số phiên" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Margin="10"
                               Text="Chưa khai thác nguồn nào nên chưa có danh sách đuôi file.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableEmptyStateText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoExtensions}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="20,16"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsRefreshing, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <StackPanel MinWidth="190">
                            <TextBlock HorizontalAlignment="Center"
                                       Margin="0,0,0,12"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       Text="Đang tải đuôi file..." />
                            <ProgressBar Height="6"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
