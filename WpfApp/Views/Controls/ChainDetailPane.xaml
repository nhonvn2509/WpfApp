<UserControl x:Class="WpfApp.Views.Controls.ChainDetailPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide">
    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding SelectedRow.Profile}"
                       Style="{StaticResource TableSectionTitle}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SelectedRow.Profile}" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <iconPacks:PackIconLucide Kind="Link"
                                          Width="13"
                                          Height="13"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource ThirdlyTextBrush}" />
                <TextBlock Margin="5,0,0,0"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource ThirdlyTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedRow.Modem}"
                           ToolTip="{Binding SelectedRow.Modem}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDetail}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ItemsControl ItemsSource="{Binding DetailItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource ThirdlyTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}" />
                            <TextBlock Grid.Column="1"
                                       FontSize="11"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding Value}"
                                       ToolTip="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDetail}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource TableEmptyStateText}"
                       Text="Chưa chọn nguồn nào. Bấm một dòng ở bảng Nguồn để xem chi tiết." />
        </StackPanel>
    </Grid>
</UserControl>