<UserControl x:Class="WpfApp.Views.Controls.FilePreviewPane"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        Unloaded="FilePreviewPane_Unloaded">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="8,6"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FilePathText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource ThirdlyTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="RefreshPreviewButton"
                            Click="RefreshPreview_Click"
                            Style="{StaticResource TableToolButton}"
                            ToolTip="Tải lại nội dung xem trước"
                            AutomationProperties.AutomationId="RefreshFilePreviewButton">
                        <iconPacks:PackIconLucide Kind="RefreshCw" Width="15" Height="15" />
                    </Button>
                    <Button x:Name="OpenFolderButton"
                            Margin="4,0,0,0"
                            Click="OpenFolder_Click"
                            Style="{StaticResource TableToolButton}"
                            ToolTip="Mở thư mục chứa tệp"
                            AutomationProperties.AutomationId="OpenFileFolderButton">
                        <iconPacks:PackIconLucide Kind="FolderOpen" Width="15" Height="15" />
                    </Button>
                    <Button x:Name="CopyPathButton"
                            Margin="4,0,0,0"
                            Click="CopyPath_Click"
                            Style="{StaticResource TableToolButton}"
                            ToolTip="Sao chép đường dẫn tệp"
                            AutomationProperties.AutomationId="CopyFilePathButton">
                        <iconPacks:PackIconLucide Kind="Copy" Width="15" Height="15" />
                    </Button>
                    <Button x:Name="FilePropertiesButton"
                            Margin="4,0,8,0"
                            Click="FileProperties_Click"
                            Style="{StaticResource TableToolButton}"
                            ToolTip="Xem thuộc tính tệp"
                            AutomationProperties.AutomationId="FilePropertiesButton">
                        <iconPacks:PackIconLucide Kind="FileText" Width="15" Height="15" />
                    </Button>
                    <Button x:Name="FitImageButton"
                            Margin="0,0,8,0"
                            Click="FitImage_Click"
                            Style="{StaticResource TableToolButton}"
                            ToolTip="Chuyển chế độ căn ảnh"
                            AutomationProperties.AutomationId="FitPreviewImageButton">
                        <iconPacks:PackIconLucide Kind="Maximize" Width="15" Height="15" />
                    </Button>
                    <Button Content="Mở bằng ứng dụng mặc định"
                            Click="OpenExternal_Click"
                            Style="{StaticResource TableToolButton}"
                            AutomationProperties.AutomationId="OpenFileExternalButton" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom"
                Margin="0,6,0,0"
                Padding="8,4"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{DynamicResource ThirdlyTextBrush}"
                       TextWrapping="Wrap" />
        </Border>
        <Border Margin="0,6,0,0"
                Padding="6"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Image x:Name="ImagePreview"
                       Visibility="Collapsed"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
                <TextBox x:Name="TextPreview"
                         Visibility="Collapsed"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="13"
                         Background="{DynamicResource RegionBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderThickness="0" />
                <Grid x:Name="MediaPreview"
                      Visibility="Collapsed"
                      Background="Black">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <MediaElement x:Name="MediaPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Stretch="Uniform"
                                  MediaOpened="MediaPlayer_MediaOpened"
                                  MediaFailed="MediaPlayer_MediaFailed"
                                  MediaEnded="MediaPlayer_MediaEnded" />
                    <Border x:Name="AudioArtwork"
                            Grid.Row="0"
                            Visibility="Collapsed"
                            Background="{DynamicResource RegionBrush}"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="ĐANG PHÁT ÂM THANH"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="AudioFileName"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource ThirdlyTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1"
                            Padding="8"
                            Background="{DynamicResource SecondaryRegionBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayPauseButton"
                                    Content="Phát"
                                    Click="PlayPause_Click"
                                    Style="{StaticResource TableToolButton}"
                                    Margin="0,0,6,0" />
                            <Button Grid.Column="1"
                                    Content="Dừng"
                                    Click="Stop_Click"
                                    Style="{StaticResource TableToolButton}"
                                    Margin="0,0,8,0" />
                            <Slider x:Name="PositionSlider"
                                    Grid.Column="2"
                                    Minimum="0"
                                    VerticalAlignment="Center"
                                    ValueChanged="PositionSlider_ValueChanged" />
                            <TextBlock x:Name="PlaybackTimeText"
                                       Grid.Column="3"
                                       MinWidth="100"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="00:00 / 00:00"
                                       TextAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel x:Name="UnknownPreview"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="720">
                    <TextBlock x:Name="UnknownTitle"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="UnknownDescription"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource ThirdlyTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="FileDetailsText"
                               Margin="0,14,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
